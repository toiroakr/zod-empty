{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:best-practices", ":automergeMinor", ":dependencyDashboard"],
  "labels": ["dependencies"],
  "gitIgnoredAuthors": ["271965483+toiroakr-release-bot[bot]@users.noreply.github.com"],
  "minimumReleaseAge": "7 days",
  "prCreation": "not-pending",
  "internalChecksFilter": "strict",
  "internalChecksAsSuccess": true,
  "prConcurrentLimit": 5,
  "rangeStrategy": "auto",
  "packageRules": [
    {
      "matchDepTypes": ["devDependencies"],
      "rangeStrategy": "pin"
    },
    {
      "matchDepTypes": ["dependencies"],
      "rangeStrategy": "bump"
    },
    {
      "matchDepTypes": ["peerDependencies"],
      "automerge": false
    },
    {
      "groupName": "testing",
      "matchPackageNames": ["vitest", "@vitest/*"],
      "minimumGroupSize": 3
    },
    {
      "groupName": "linting and formatting",
      "matchPackageNames": ["oxfmt", "oxlint"]
    },
    {
      "groupName": "typescript",
      "matchPackageNames": ["typescript", "@types/*"]
    },
    {
      "matchUpdateTypes": ["major"],
      "automerge": false
    },
    {
      "description": "Keep npm updates behind the same seven-day cooldown as pnpm.",
      "matchDatasources": ["npm"],
      "matchUpdateTypes": ["major", "minor", "patch"],
      "minimumReleaseAge": "7 days"
    },
    {
      "matchDatasources": ["npm"],
      "matchPackageNames": ["react", "react-dom"],
      "groupName": "react runtime",
      "minimumGroupSize": 2
    },
    {
      "matchDatasources": ["npm"],
      "matchPackageNames": ["@types/react", "@types/react-dom"],
      "groupName": "react types"
    }
  ],
  "platformAutomerge": false
}
