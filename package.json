{
  "name": "zod-empty",
  "version": "2.2.1",
  "description": "generate minimum data from zod schema.",
  "packageManager": "pnpm@11.18.0",
  "types": "./dist/index.d.mts",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "scripts": {
    "prepare": "lefthook install",
    "build": "tsdown",
    "changeset": "changeset",
    "release": "pnpm build && changeset publish",
    "check": "biome check --write",
    "check:force": "biome check --write --unsafe",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/toiroakr/zod-empty.git"
  },
  "keywords": [
    "zod",
    "empty",
    "schema",
    "react-hook-form"
  ],
  "author": "toiroakr",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/toiroakr/zod-empty/issues"
  },
  "homepage": "https://github.com/toiroakr/zod-empty#readme",
  "dependencies": {
    "just-clone": "^6.2.0"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@changesets/cli": "3.0.0",
    "@vitest/coverage-v8": "2.1.9",
    "@vitest/ui": "2.1.8",
    "lefthook": "1.13.6",
    "pkg-pr-new": "0.0.41",
    "tsdown": "0.21.10",
    "typescript": "6.0.2",
    "vitest": "2.1.8",
    "vitest-github-actions-reporter": "0.11.1",
    "zod": "4.4.3"
  },
  "peerDependencies": {
    "typescript": ">=5.0.0",
    "zod": "4.x"
  },
  "files": [
    "dist/**/*",
    "!src/index.spec.ts",
    "src/index.ts"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=22.13"
  },
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  }
}
