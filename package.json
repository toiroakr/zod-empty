{
  "name": "zod-empty",
  "version": "2.2.1",
  "description": "generate minimum data from zod schema.",
  "keywords": [
    "empty",
    "react-hook-form",
    "schema",
    "zod"
  ],
  "homepage": "https://github.com/toiroakr/zod-empty#readme",
  "bugs": {
    "url": "https://github.com/toiroakr/zod-empty/issues"
  },
  "license": "MIT",
  "author": "toiroakr",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/toiroakr/zod-empty.git"
  },
  "files": [
    "dist/**/*",
    "!src/index.spec.ts",
    "src/index.ts"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "prepare": "lefthook install",
    "build": "tsdown",
    "changeset": "changeset",
    "release": "pnpm build && changeset publish",
    "check": "pnpm format:check && pnpm lint",
    "check:force": "pnpm format && pnpm lint:fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint --deny-warnings .",
    "lint:fix": "oxlint --fix --deny-warnings .",
    "build:sample": "pnpm --filter @zod-empty/react-hook-form build"
  },
  "dependencies": {
    "just-clone": "^6.2.0"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "@vitest/coverage-v8": "2.1.9",
    "@vitest/ui": "2.1.9",
    "lefthook": "2.2.1",
    "oxfmt": "0.72.0",
    "oxlint": "1.87.0",
    "pkg-pr-new": "0.0.91",
    "tsdown": "0.21.10",
    "typescript": "6.0.3",
    "vitest": "2.1.9",
    "vitest-github-actions-reporter": "0.11.1",
    "zod": "4.6.5"
  },
  "peerDependencies": {
    "typescript": ">=5.0.0",
    "zod": "4.x"
  },
  "engines": {
    "node": ">=22.13"
  },
  "packageManager": "pnpm@12.11.2"
}
